    {
      "name": "questions",
      "path": [
        "data/questions/ls14.csv",
        "data/questions/ls15.csv",
        "data/questions/ls16.csv",
        "data/questions/ls17.csv",
        "data/questions/ls18.csv"
      ],
      "format": "csv",
      "description": "One row per question",
      "schema": {
        "fields": [
          {
            "name": "lok_sabha",
            "type": "integer",
            "description": "Lok Sabha, such as 17"
          },
          {
            "name": "session",
            "type": "integer",
            "description": "Session of that Lok Sabha"
          },
          {
            "name": "type",
            "type": "string",
            "description": "STARRED (answered orally in the House) or UNSTARRED (answered in writing)"
          },
          {
            "name": "question_no",
            "type": "integer",
            "description": "Question number. Starred and unstarred questions are numbered separately within a session"
          },
          {
            "name": "date",
            "type": "date",
            "description": "Date the question was answered"
          },
          {
            "name": "ministry",
            "type": [
              "string",
              "null"
            ],
            "description": "Ministry that answered"
          },
          {
            "name": "subject",
            "type": [
              "string",
              "null"
            ],
            "description": "Subject, as published"
          },
          {
            "name": "members",
            "type": "string",
            "description": "Members who asked, names as published, separated by '; '"
          },
          {
            "name": "pdf_url",
            "type": [
              "string",
              "null"
            ],
            "description": "Question and answer, PDF"
          },
          {
            "name": "pdf_url_hindi",
            "type": [
              "string",
              "null"
            ],
            "description": "Question and answer in Hindi, PDF"
          },
          {
            "name": "doc_url",
            "type": [
              "string",
              "null"
            ],
            "description": "Question and answer, Word file"
          },
          {
            "name": "doc_url_hindi",
            "type": [
              "string",
              "null"
            ],
            "description": "Question and answer in Hindi, Word file"
          }
        ]
      }
    },
